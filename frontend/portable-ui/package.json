{
  "name": "portable-ui",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "A portable React component library: shadcn/ui components restyled (Geist, black and white with semantic colour, marks), with panes, a sidebar, charts and a playground.",
  "engines": {
    "node": ">=20.19"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/base/index.ts",
    "./derived": "./src/derived/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "predev:playground": "node scripts/ensure-install.mjs",
    "dev:playground": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "shot": "node scripts/shot.mjs",
    "measure:panes": "node scripts/measure-panes.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
